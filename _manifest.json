{
  "manifest_version": 2,
  "id": "maibot-mute-alert",
  "name": "被禁言告警插件",
  "version": "1.1.0",
  "description": "监控并在 MaiBot 被群禁言时自动发送告警到指定群聊或指定管理员",
  "author": {
    "name": "lrony22",
    "url": "https://github.com/lrony22"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/lrony22/maibot-mute-alert"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
